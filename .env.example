# ================================================================
# SALES-BOT ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env lalu isi nilainya
# ================================================================

# 1. TELEGRAM CONFIGURATION
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# ID Akun Telegram pribadi Anda dari @userinfobot (hanya ID ini yang bisa akses bot)
TELEGRAM_ALLOWED_CHAT_ID=123456789

# 2. GOOGLE GEMINI AI
# API Key dari https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# 3. GOOGLE SPREADSHEETS
# ID dari URL Google Sheets (docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz12345
# Path file service account credentials
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# 4. GMAIL OUTBOUND (GMAIL SENDER)
# Alamat akun Gmail pengirim (bot sender)
GMAIL_SENDER_EMAIL=bot.sender@gmail.com
# Password aplikasi 16-karakter dari myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Nama tampilan pengirim di email
GMAIL_SENDER_NAME=Rizki - Sales Solution

# 5. CALENDLY & OUTREACH SETTINGS
CALENDLY_BOOKING_LINK=https://calendly.com/your-username/15min
# Batas maksimal email blast per hari (untuk keamanan akun Gmail lama)
DAILY_MAX_EMAILS=7
# Jeda acak antar email (detik)
EMAIL_DELAY_MIN_SEC=90
EMAIL_DELAY_MAX_SEC=180

# 6. VPS WEBHOOK SERVER SETTINGS
PORT=8000
HOST=0.0.0.0
# URL publik VPS Anda (misal: https://api.domainanda.my.id)
PUBLIC_WEBHOOK_BASE_URL=https://api.yourdomain.my.id
